<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet publish src/PixieDownloader/PixieDownloader.csproj -c Release -p:PublishProfile=Portable -->
<!-- Single ~1 MB PixieDownloader.exe. Requires the .NET 10 Desktop Runtime on the target machine. -->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishDir>bin\publish\portable\</PublishDir>
  </PropertyGroup>
</Project>
