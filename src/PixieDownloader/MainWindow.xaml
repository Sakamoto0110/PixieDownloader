<Window x:Class="PixieDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixieDownloader"
        xmlns:views="clr-namespace:PixieDownloader.Views"
        xmlns:vm="clr-namespace:PixieDownloader.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="PixieDownloader" Height="800" Width="1280" MinHeight="420" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{StaticResource Brush.Bg.Base}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Family}" FontSize="{StaticResource Font.Body}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Overall queue progress on the taskbar button -->
    <Window.TaskbarItemInfo>
        <shell:TaskbarItemInfo ProgressValue="{Binding TaskbarProgress}" ProgressState="{Binding TaskbarState}"/>
    </Window.TaskbarItemInfo>

    <!-- Below the design size (940x560) the whole content is scaled down instead of clipping; see MainWindow.UpdateScale. -->
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ Header ═══════════ -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Accent.Subtle}">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="LogoBadge" Width="28" Height="28" CornerRadius="8" Background="{StaticResource Brush.Accent.Primary}"
                            VerticalAlignment="Center" ClipToBounds="True">
                        <Grid>
                            <TextBlock x:Name="LogoFallback" Text="P" Foreground="White" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="LogoImage" Stretch="Uniform"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="PixieDownloader" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <!-- Hit-test visible in the chrome, otherwise the caption area swallows the hover and the tooltip never shows -->
                    <Border Background="{StaticResource Brush.Bg.Elevated}" CornerRadius="5" Padding="6,1" Margin="8,1,0,0" VerticalAlignment="Center"
                            ToolTip="{x:Static local:AppInfo.VersionDetail}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock Text="{x:Static local:AppInfo.VersionLabel}" Style="{StaticResource Hint}" FontSize="11"/>
                    </Border>
                    <!-- Source on GitHub: the octicon mark, hand cursor, tooltip = the repo URL, click opens it -->
                    <Button Style="{StaticResource IconButton}" Margin="4,1,0,0" VerticalAlignment="Center" Click="OnOpenRepository"
                            ToolTip="{x:Static local:AppInfo.RepositoryUrl}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource Brush.Text.Secondary}"
                              Data="M 8 0 C 3.58 0 0 3.58 0 8 c 0 3.54 2.29 6.53 5.47 7.59 .4 .07 .55 -.17 .55 -.38 0 -.19 -.01 -.82 -.01 -1.49 -2.01 .37 -2.53 -.49 -2.69 -.94 -.09 -.23 -.48 -.94 -.82 -1.13 -.28 -.15 -.68 -.52 -.01 -.53 .63 -.01 1.08 .58 1.23 .82 .72 1.21 1.87 .87 2.33 .66 .07 -.52 .28 -.87 .51 -1.07 -1.78 -.2 -3.64 -.89 -3.64 -3.95 0 -.87 .31 -1.59 .82 -2.15 -.08 -.2 -.36 -1.02 .08 -2.12 0 0 .67 -.21 2.2 .82 .64 -.18 1.32 -.27 2 -.27 .68 0 1.36 .09 2 .27 1.53 -1.04 2.2 -.82 2.2 -.82 .44 1.1 .16 1.92 .08 2.12 .51 .56 .82 1.27 .82 2.15 0 3.07 -1.87 3.75 -3.65 3.95 .29 .25 .54 .73 .54 1.48 0 1.07 -.01 1.93 -.01 2.2 0 .21 .15 .46 .55 .38 A 8.013 8.013 0 0 0 16 8 c 0 -4.42 -3.58 -8 -8 -8 z"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Background="{StaticResource Brush.Warning}" CornerRadius="6" Padding="8,3" Margin="0,0,8,0"
                            VerticalAlignment="Center" Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Atualizar" Foreground="#1A1A1A" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="Atualizar yt-dlp" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,12,0"
                            Command="{Binding UpdateYtDlpCommand}"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"/>

                    <Button Content="Verificar atualização" Style="{StaticResource GhostButton}" Padding="10,5"
                            Command="{Binding CheckUpdateCommand}" Margin="0,0,12,0"/>

                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimizar">
                        <Path Data="M 0,5 H 10" Stroke="{StaticResource Brush.Text.Primary}" StrokeThickness="1.2"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestore" ToolTip="Maximizar">
                        <Path Data="M 0,0 H 10 V 10 H 0 Z" Stroke="{StaticResource Brush.Text.Primary}" StrokeThickness="1.2"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}" Click="OnClose" ToolTip="Fechar">
                        <Path Data="M 0,0 L 10,10 M 0,10 L 10,0" Stroke="{StaticResource Brush.Text.Primary}" StrokeThickness="1.2"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ Tabs ═══════════ -->
        <!-- Baixar · Fila · Plugins · [plugin tabs, inserted at runtime by MainWindow.WirePluginTabs in the folder's order]
             · Debug / Tests (only while enabled through the status-bar dot) · Logs, always last. -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="16,12,16,0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="Baixar">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{Binding PreviewColumnWidth}"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Notices (previous session) ── -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                        <Border Background="{StaticResource Brush.Accent.Subtle}" BorderBrush="{StaticResource Brush.Warning}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                                Visibility="{Binding StartupNotice, Converter={StaticResource NotNullToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="OK" Style="{StaticResource GhostButton}" Padding="10,4" Margin="12,0,0,0"
                                        VerticalAlignment="Center" Command="{Binding DismissNoticeCommand}"/>
                                <TextBlock Text="⚠" Foreground="{StaticResource Brush.Warning}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StartupNotice}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <Border Background="{StaticResource Brush.Accent.Subtle}" BorderBrush="{StaticResource Brush.Accent.Primary}" BorderThickness="1"
                                CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                                Visibility="{Binding HasRestoredJobs, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Button Content="Descartar" Style="{StaticResource GhostButton}" Padding="10,4" Command="{Binding DiscardPendingCommand}"/>
                                    <Button Content="Continuar" Padding="12,4" Margin="6,0,0,0" Command="{Binding ContinuePendingCommand}"/>
                                    <Button Content="Ver fila" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0" Command="{Binding ShowQueueCommand}"/>
                                </StackPanel>
                                <TextBlock Text="⏳" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RestoredBanner}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Main column (scrollable) ── -->
                    <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <!-- "Importar ▾": .txt file, or paste links into a dialog -->
                                        <Grid DockPanel.Dock="Right" Margin="10,0,0,0">
                                            <ToggleButton x:Name="ImportToggle" Style="{StaticResource GhostToggleButton}" Padding="10,5"
                                                          ToolTip="Importa uma lista de URLs pra revisar e baixar em lote">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Importar"/>
                                                    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5"
                                                          VerticalAlignment="Center" Margin="8,1,0,0"/>
                                                </StackPanel>
                                            </ToggleButton>
                                            <Popup IsOpen="{Binding IsChecked, ElementName=ImportToggle, Mode=TwoWay}" StaysOpen="False"
                                                   PlacementTarget="{Binding ElementName=ImportToggle}" Placement="Bottom"
                                                   AllowsTransparency="True" PopupAnimation="Fade">
                                                <Border Background="{StaticResource Brush.Bg.Surface}" BorderBrush="{StaticResource Brush.Border.Default}"
                                                        BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Padding="6" MinWidth="220">
                                                    <StackPanel>
                                                        <Button Style="{StaticResource MenuButton}" Click="OnImportMenuClick" Command="{Binding ImportQueueCommand}"
                                                                ToolTip="Um .txt com 1 URL por linha. 1ª linha: &quot;# Download as mp3&quot; (só áudio) ou &quot;# Download as mp4&quot; (vídeo+áudio).&#10;O nome do arquivo vira a subpasta de saída.">
                                                            <StackPanel>
                                                                <TextBlock Text="De um arquivo .txt…"/>
                                                                <TextBlock Text="1 URL por linha; o nome do arquivo vira subpasta" Style="{StaticResource Hint}"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource MenuButton}" Click="OnImportMenuClick" Command="{Binding PasteLinksCommand}">
                                                            <StackPanel>
                                                                <TextBlock Text="Colar links…"/>
                                                                <TextBlock Text="Cole várias URLs numa janela" Style="{StaticResource Hint}"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <TextBox VerticalContentAlignment="Center"
                                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Cole uma URL de vídeo ou playlist — a análise começa sozinha. Enter analisa de novo.">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Return" Command="{Binding AnalyzeCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <CheckBox DockPanel.Dock="Right" Content="Baixar vídeo" Margin="12,0,0,0"
                                                  IsChecked="{Binding DownloadVideo, Mode=TwoWay}"
                                                  ToolTip="Baixa o arquivo de vídeo (MP4) em vez de extrair só o áudio"/>
                                        <CheckBox Content="Tratar como playlist (quando a URL tiver uma lista)"
                                                  IsChecked="{Binding TreatAsPlaylist, Mode=TwoWay}"/>
                                    </DockPanel>

                                    <!-- Video options — an expander, revealed when "Baixar vídeo" is checked -->
                                    <Expander Header="Opções avançadas de vídeo" Margin="0,12,0,0"
                                              IsExpanded="{Binding Settings.Ui.VideoOptionsExpanded, Mode=TwoWay}"
                                              Visibility="{Binding DownloadVideo, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Margin="0,4,0,0">
                                        <CheckBox Content="Extrair GIF"
                                                  IsChecked="{Binding ExtractGif, Mode=TwoWay}"
                                                  ToolTip="Extrai só o trecho selecionado abaixo como um .gif animado (sem áudio), em vez do vídeo inteiro"/>

                                        <StackPanel Visibility="{Binding ExtractGif, Converter={StaticResource InverseBoolToVis}}">
                                            <CheckBox Content="Extrair com áudio" Margin="0,8,0,0"
                                                      IsChecked="{Binding Settings.Video.IncludeAudio, Mode=TwoWay}"
                                                      ToolTip="Desmarcada: o MP4 vem sem áudio (mudo)"/>
                                            <CheckBox Content="Extrair áudio separado em .mp3" Margin="0,8,0,0"
                                                      IsChecked="{Binding Settings.Video.ExtractAudioSeparate, Mode=TwoWay}"
                                                      ToolTip="Gera também um arquivo .mp3 só com o áudio, ao lado do vídeo"/>
                                            <DockPanel Margin="0,14,0,0">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                           Text="{Binding Settings.Video.Speed, StringFormat={}{0:0.##}x}"/>
                                                <TextBlock Text="Velocidade do vídeo" Style="{StaticResource Label}"/>
                                            </DockPanel>
                                            <Slider Minimum="0.1" Maximum="8" IsSnapToTickEnabled="True" TickFrequency="0.05"
                                                    Value="{Binding Settings.Video.Speed, Mode=TwoWay}"/>
                                            <TextBlock Text="Abaixo de 1x = câmera lenta; acima = acelerado. Re-encoda o vídeo (pode demorar)."
                                                       Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Recorte genérico (início/fim) — qualquer download de vídeo, exceto modo GIF -->
                                        <StackPanel Visibility="{Binding ShowGenericTrim, Converter={StaticResource BoolToVis}}">
                                            <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Margin="0,12,0,0"/>
                                            <DockPanel Margin="0,12,0,0">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                           Text="{Binding TrimRangeText}"/>
                                                <TextBlock Text="Recorte (início / fim)" Style="{StaticResource Label}"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBox DockPanel.Dock="Right" Width="110" VerticalContentAlignment="Center"
                                                         Text="{Binding TrimStartText, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Início exato com milissegundos (h:mm:ss.fff, ex.: 3:15:42.500) — em vídeos longos o slider sozinho não é preciso o bastante"/>
                                                <TextBlock Text="Início" Style="{StaticResource Hint}"/>
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="{Binding TrimMaxSeconds}" Value="{Binding TrimStartSeconds, Mode=TwoWay}"/>
                                            <TextBlock Text="Fim" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                                            <Slider Minimum="0" Maximum="{Binding TrimMaxSeconds}" Value="{Binding TrimEndSeconds, Mode=TwoWay}"/>
                                            <TextBlock Text="Baixa só esse trecho do vídeo (yt-dlp --download-sections, corte exato via --force-keyframes-at-cuts). Deixe os dois extremos pra baixar o vídeo inteiro."
                                                       Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Recorte do GIF: início (posição, útil em vídeos longos) + duração curta e amigável -->
                                        <StackPanel Visibility="{Binding ShowGifTrim, Converter={StaticResource BoolToVis}}">
                                            <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Margin="0,12,0,0"/>
                                            <DockPanel Margin="0,12,0,0">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                           Text="{Binding GifRangeText}"/>
                                                <TextBlock Text="Trecho do GIF" Style="{StaticResource Label}"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBox DockPanel.Dock="Right" Width="110" VerticalContentAlignment="Center"
                                                         Text="{Binding TrimStartText, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Início exato com milissegundos (h:mm:ss.fff, ex.: 3:15:42.500) — em vídeos longos o slider sozinho não é preciso o bastante"/>
                                                <TextBlock Text="Início (posição no vídeo)" Style="{StaticResource Hint}"/>
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="{Binding TrimMaxSeconds}" Value="{Binding TrimStartSeconds, Mode=TwoWay}"/>
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBox DockPanel.Dock="Right" Width="90" VerticalContentAlignment="Center"
                                                         Text="{Binding GifDurationText, UpdateSourceTrigger=LostFocus}"
                                                         ToolTip="Duração exata em segundos (ex.: 1.25) — o slider sozinho não é preciso o bastante pra achar o tamanho exato de um loop"/>
                                                <TextBlock Text="Duração do GIF (segundos)" Style="{StaticResource Hint}"/>
                                            </DockPanel>
                                            <Slider Minimum="1" Maximum="20" SmallChange="0.05" LargeChange="1"
                                                    Value="{Binding GifDurationSeconds, Mode=TwoWay}"/>
                                            <TextBlock Text="Baixa só esse trecho (independente da duração do vídeo original) e converte pra .gif animado, sem áudio. Ajuste fino: digite os valores exatos à direita."
                                                       Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                                            <DockPanel Margin="0,14,0,0">
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                           Text="{Binding Settings.Video.GifSpeed, StringFormat={}{0:0.00}x}"/>
                                                <TextBlock Text="Velocidade do GIF" Style="{StaticResource Label}"/>
                                            </DockPanel>
                                            <Slider Minimum="0.25" Maximum="1" IsSnapToTickEnabled="True" TickFrequency="0.25"
                                                    Value="{Binding Settings.Video.GifSpeed, Mode=TwoWay}"/>
                                            <TextBlock Text="Câmera lenta pra ver o loop com mais detalhe. Também se aplica à prévia (Analisar GIF)."
                                                       Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                                            <DockPanel Margin="0,12,0,0">
                                                <Button DockPanel.Dock="Right" Content="Abrir prévia" Command="{Binding OpenGifPreviewCommand}"
                                                        Style="{StaticResource GhostButton}" Padding="10,5" Margin="8,0,0,0"
                                                        Visibility="{Binding HasGifPreview, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="Reabre o trecho já baixado (sem baixar de novo) no player padrão do Windows"/>
                                                <Button Content="Analisar GIF (baixa ~20s de prévia)" Command="{Binding AnalyzeGifPreviewCommand}"
                                                        HorizontalAlignment="Left"/>
                                            </DockPanel>
                                            <TextBlock Text="Baixa só um trechinho de ~20s a partir do Início e abre no player padrão — use pra achar visualmente o loop exato antes de baixar o GIF de verdade."
                                                       Style="{StaticResource Hint}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Border Style="{StaticResource Card}" MinHeight="84" Padding="12,14" VerticalAlignment="Top"
                                        Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Cole uma URL acima" Style="{StaticResource SectionTitle}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Vídeos e playlists do YouTube e demais sites suportados pelo yt-dlp — a análise começa sozinha"
                                                   Style="{StaticResource Hint}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" VerticalAlignment="Top"
                                        Visibility="{Binding SingleVideo, Converter={StaticResource NotNullToVis}}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="160" Height="90" CornerRadius="6" Background="#000000"
                                                ClipToBounds="True" Margin="0,0,14,0" VerticalAlignment="Top">
                                            <Image Source="{Binding PreviewThumbnailPath, Converter={StaticResource PathToImage}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Vídeo único" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding SingleVideo.Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding SingleVideo.Uploader}" Style="{StaticResource Hint}"/>
                                                <TextBlock Text="  •  " Style="{StaticResource Hint}"/>
                                                <TextBlock Text="{Binding SingleVideo.Duration, Converter={StaticResource Duration}}" Style="{StaticResource Hint}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <views:PlaylistPanel VerticalAlignment="Top"
                                                     Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVis}}"/>
                            </Grid>

                            <views:AdvancedOptionsPanel/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Sticky footer: the actions never scroll away ── -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="12,10" Margin="0,10,12,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding DownloadButtonLabel}" MinWidth="180" Padding="16,9"
                                    Command="{Binding DownloadCommand}"
                                    ToolTip="Adiciona à fila e começa a baixar (a fila continua enquanto você analisa outras URLs)"/>
                            <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource GhostButton}" MinWidth="100" Margin="0,0,8,0"
                                    Command="{Binding CancelCommand}"
                                    ToolTip="Interrompe o primeiro item em andamento da fila e apaga seus arquivos temporários"/>
                            <Button DockPanel.Dock="Right" Content="{Binding QueueButtonLabel}" Style="{StaticResource GhostButton}" MinWidth="100" Margin="0,0,8,0"
                                    Command="{Binding ShowQueueCommand}"/>
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedCountText}"
                                       Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVis}}"/>
                        </DockPanel>
                    </Border>

                    <!-- ── Sidebar: preview + metadata (collapsible) ── -->
                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <!-- Collapsed rail -->
                            <Button Style="{StaticResource GhostButton}" Padding="4" Margin="4"
                                    Command="{Binding TogglePreviewCollapsedCommand}" ToolTip="Expandir pré-visualização"
                                    VerticalAlignment="Stretch"
                                    Visibility="{Binding IsPreviewCollapsed, Converter={StaticResource BoolToVis}}">
                                <Path Data="M 5,0 L 0,5 L 5,10" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5"
                                      VerticalAlignment="Center"/>
                            </Button>

                            <!-- Expanded content -->
                            <DockPanel Margin="12" Visibility="{Binding IsPreviewCollapsed, Converter={StaticResource InverseBoolToVis}}">
                                <DockPanel DockPanel.Dock="Top">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,3"
                                            Command="{Binding TogglePreviewCollapsedCommand}" ToolTip="Recolher pré-visualização">
                                        <Path Data="M 0,0 L 5,5 L 0,10" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5"/>
                                    </Button>
                                    <TextBlock Text="Pré-visualização" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Border CornerRadius="8" ClipToBounds="True" Background="#000000" MinHeight="200" VerticalAlignment="Top"
                                                Cursor="Hand" ToolTip="{Binding PreviewUrl}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenPreviewCommand}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Image Source="{Binding PreviewThumbnailPath, Converter={StaticResource PathToImage}}" Stretch="Uniform"/>
                                                <TextBlock Text="(sem prévia)" Style="{StaticResource Hint}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding PreviewThumbnailPath, Converter={StaticResource NullToVis}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Margin="0,12,0,0"
                                                    Visibility="{Binding SelectedPlaylistItem, Converter={StaticResource NotNullToVis}}">
                                            <TextBlock Text="{Binding SelectedPlaylistItem.Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding SelectedPlaylistItem.Uploader}" Style="{StaticResource Hint}"/>
                                                <TextBlock Text="  •  " Style="{StaticResource Hint}"/>
                                                <TextBlock Text="{Binding SelectedPlaylistItem.Duration, Converter={StaticResource Duration}}" Style="{StaticResource Hint}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <views:MetadataPanel Margin="0,14,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding QueueTabHeader}">
                <views:QueuePanel Margin="0,4,0,0"/>
            </TabItem>

            <TabItem Header="Plugins">
                <views:PluginsPanel Margin="0,4,0,0"/>
            </TabItem>

            <TabItem x:Name="DebugTab" Header="Debug / Tests"
                     Visibility="{Binding Settings.Ui.DebugPanelEnabled, Converter={StaticResource BoolToVis}}">
                <views:DebugPanel Margin="0,4,0,0"/>
            </TabItem>

            <TabItem Header="Logs">
                <views:LogsPanel Margin="0,4,0,0"/>
            </TabItem>
        </TabControl>

        <!-- ═══════════ Status bar ═══════════ -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Bg.Surface}" BorderBrush="{StaticResource Brush.Border.Subtle}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <ProgressBar Grid.Column="1" VerticalAlignment="Center" Margin="16,0" Height="8"
                             Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding QueueSummary}" Style="{StaticResource Hint}"
                               Visibility="{Binding QueueSummary, Converter={StaticResource NotNullToVis}}"/>
                    <TextBlock Text="  •  " Style="{StaticResource Hint}"
                               Visibility="{Binding SpeedText, Converter={StaticResource NotNullToVis}}"/>
                    <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Hint}"
                               Visibility="{Binding SpeedText, Converter={StaticResource NotNullToVis}}"/>
                    <TextBlock Text="  •  ETA " Style="{StaticResource Hint}"
                               Visibility="{Binding EtaText, Converter={StaticResource NotNullToVis}}"/>
                    <TextBlock Text="{Binding EtaText}" Style="{StaticResource Hint}"
                               Visibility="{Binding EtaText, Converter={StaticResource NotNullToVis}}"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The debug dot, built exactly like the two indicators next to it: red = the Debug / Tests tab is
                         hidden, green = shown. Press and hold (dot or label) for five seconds to enable; one click
                         while green hides it again. No tooltip — it is not meant to explain itself. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" Background="Transparent"
                                MouseLeftButtonDown="OnDebugDotMouseDown" MouseLeftButtonUp="OnDebugDotMouseUp" MouseLeave="OnDebugDotMouseLeave">
                        <Ellipse x:Name="DebugDot" Width="9" Height="9" VerticalAlignment="Center"/>
                        <TextBlock Text="debug" Margin="6,0,0,0" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" ToolTip="{Binding YtDlp.Tooltip}">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{Binding YtDlp.GlyphColorKey, Converter={StaticResource ResBrush}}"/>
                        <TextBlock Text="yt-dlp" Margin="6,0,0,0" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <Button Content="Instalar" Style="{StaticResource GhostButton}" Padding="8,2" Margin="6,0,0,0" FontSize="11"
                                Command="{Binding InstallYtDlpCommand}"
                                Visibility="{Binding YtDlp.Installed, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Ffmpeg.Tooltip}">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{Binding Ffmpeg.GlyphColorKey, Converter={StaticResource ResBrush}}"/>
                        <TextBlock Text="ffmpeg" Margin="6,0,0,0" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <Button Content="Instalar" Style="{StaticResource GhostButton}" Padding="8,2" Margin="6,0,0,0" FontSize="11"
                                Command="{Binding InstallFfmpegCommand}"
                                Visibility="{Binding Ffmpeg.Installed, Converter={StaticResource InverseBoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
