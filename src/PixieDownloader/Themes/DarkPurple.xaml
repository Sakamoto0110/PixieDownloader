<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ════════════════════ Colors ════════════════════ -->
    <!-- Backgrounds -->
    <Color x:Key="Bg.Base">#16161B</Color>
    <Color x:Key="Bg.Surface">#1F1F26</Color>
    <Color x:Key="Bg.Elevated">#2A2A33</Color>
    <Color x:Key="Bg.Hover">#33333D</Color>

    <!-- Purple primary -->
    <Color x:Key="Accent.Primary">#7B3FC9</Color>
    <Color x:Key="Accent.Hover">#9355E0</Color>
    <Color x:Key="Accent.Pressed">#6532A8</Color>
    <Color x:Key="Accent.Subtle">#2D1B47</Color>

    <!-- Text -->
    <Color x:Key="Text.Primary">#F2F2F5</Color>
    <Color x:Key="Text.Secondary">#A8A8B3</Color>
    <Color x:Key="Text.Tertiary">#6E6E7A</Color>
    <Color x:Key="Text.OnAccent">#FFFFFF</Color>

    <!-- Borders -->
    <Color x:Key="Border.Subtle">#2E2E38</Color>
    <Color x:Key="Border.Default">#3A3A45</Color>
    <Color x:Key="Border.Focus">#7B3FC9</Color>

    <!-- Semantic -->
    <Color x:Key="Success">#3DB97A</Color>
    <Color x:Key="Warning">#E5A246</Color>
    <Color x:Key="Error">#E5484D</Color>

    <!-- ════════════════════ Brushes ════════════════════ -->
    <SolidColorBrush x:Key="Brush.Bg.Base" Color="{StaticResource Bg.Base}"/>
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="{StaticResource Bg.Surface}"/>
    <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="{StaticResource Bg.Elevated}"/>
    <SolidColorBrush x:Key="Brush.Bg.Hover" Color="{StaticResource Bg.Hover}"/>

    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="{StaticResource Accent.Primary}"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Accent.Hover}"/>
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Accent.Pressed}"/>
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Accent.Subtle}"/>

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Text.Primary}"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Text.Secondary}"/>
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Text.Tertiary}"/>
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Text.OnAccent}"/>

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Border.Subtle}"/>
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{StaticResource Border.Default}"/>
    <SolidColorBrush x:Key="Brush.Border.Focus" Color="{StaticResource Border.Focus}"/>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Error}"/>

    <!-- ════════════════════ Shared values ════════════════════ -->
    <CornerRadius x:Key="Radius.Default">6</CornerRadius>
    <CornerRadius x:Key="Radius.Large">10</CornerRadius>
    <sys:Double x:Key="Font.Body">13</sys:Double>
    <sys:Double x:Key="Font.Hint">12</sys:Double>
    <sys:Double x:Key="Font.Section">16</sys:Double>
    <FontFamily x:Key="Font.Family">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

</ResourceDictionary>
