<UserControl x:Class="PixieDownloader.Views.DebugPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PixieDownloader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Controls -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Debug / Tests" Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="URL alvo" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding DebugUrl, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox Content="Verbose (-v)" IsChecked="{Binding DebugVerbose, Mode=TwoWay}"/>
                        <CheckBox Content="Skip download" Margin="16,0,0,0" IsChecked="{Binding DebugSkipDownload, Mode=TwoWay}"/>
                    </StackPanel>

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Simulate" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding SimulateCommand}"/>
                        <Button Content="Get filename" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding GetFilenameCommand}"/>
                        <Button Content="Get title" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding GetTitleCommand}"/>
                        <Button Content="Get duration" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding GetDurationCommand}"/>
                        <Button Content="Get thumbnail" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding GetThumbnailCommand}"/>
                        <Button Content="Get URL" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding GetDirectUrlCommand}"/>
                        <Button Content="Get ID" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding GetIdCommand}"/>
                        <Button Content="List formats (-F)" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding ListFormatsCommand}"/>
                        <Button Content="Dump JSON" Style="{StaticResource GhostButton}" Margin="0,0,6,6" Command="{Binding DumpJsonCommand}"/>
                    </WrapPanel>

                    <TextBlock Text="Args customizados (raw)" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                    <TextBox Text="{Binding RawArgs, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="64" VerticalContentAlignment="Top"
                             FontFamily="{StaticResource Font.Mono}"
                             ToolTip="Argumentos passados como array (sem shell). Use aspas para agrupar."/>
                    <Button Content="Executar" Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding RunRawCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Output -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Saída" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Copiar saída" Style="{StaticResource GhostButton}" Padding="10,5" Command="{Binding CopyOutputCommand}"/>
                        <Button Content="Limpar saída" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Command="{Binding ClearOutputCommand}"/>
                    </StackPanel>
                </DockPanel>
                <TextBox Text="{Binding DebugOutput}" IsReadOnly="True" TextWrapping="NoWrap"
                         FontFamily="{StaticResource Font.Mono}" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="{StaticResource Brush.Bg.Base}" BorderThickness="0"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
