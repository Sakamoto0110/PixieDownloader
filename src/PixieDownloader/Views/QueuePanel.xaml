<UserControl x:Class="PixieDownloader.Views.QueuePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PixieDownloader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Border Style="{StaticResource Card}" Padding="14">
        <DockPanel>
            <!-- Header + toolbar -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Limpar concluídos" Style="{StaticResource GhostButton}" Padding="10,5"
                            Command="{Binding ClearFinishedJobsCommand}"
                            ToolTip="Tira da lista tudo que já terminou (ok, falhou ou cancelado)"/>
                    <Button Content="Cancelar todos" Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0"
                            Command="{Binding CancelAllJobsCommand}"
                            ToolTip="Interrompe o que está rodando e cancela o que ainda não começou"/>
                </StackPanel>
                <TextBlock Text="{Binding QueueTabHeader}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <CheckBox DockPanel.Dock="Right" Content="Manter pendências entre sessões" VerticalAlignment="Center"
                          IsChecked="{Binding QueuePersistent, Mode=TwoWay}"
                          ToolTip="Grava o que ainda não terminou em pending-downloads.txt (ao lado do .exe). Na próxima abertura a lista volta e o botão principal vira “Continuar downloads”."/>
                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Cada item baixa por conta própria; um vídeo que passa pelo ffmpeg aparece como download → processamento, vinculados. Arraste pra reordenar."/>
            </DockPanel>

            <!-- Empty state -->
            <Grid>
                <TextBlock Text="A fila está vazia — analise uma URL e clique em Baixar." Style="{StaticResource Hint}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Jobs.Count, Converter={StaticResource ZeroToVis}}"/>

                <ListBox x:Name="JobList" ItemsSource="{Binding Jobs}" AllowDrop="True"
                         PreviewMouseLeftButtonDown="OnRowMouseDown" PreviewMouseMove="OnRowMouseMove"
                         DragOver="OnRowDragOver" Drop="OnRowDrop"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DownloadJobViewModel}">
                            <Border BorderThickness="4,0,0,0" BorderBrush="{Binding KindBrushKey, Converter={StaticResource ResBrush}}"
                                    Padding="10,7" Margin="0,1" CornerRadius="4" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Drag handle -->
                                    <TextBlock Grid.Column="0" Text="⋮⋮" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                               Margin="0,0,10,0" Cursor="SizeAll" ToolTip="Arraste pra reordenar"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Background="{Binding KindBrushKey, Converter={StaticResource ResBrush}}" Opacity="0.85">
                                                <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                       ToolTip="{Binding Url}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding StatusBrushKey, Converter={StaticResource ResBrush}}"
                                                   ToolTip="{Binding ErrorMessage}"/>
                                        <ProgressBar Height="5" Margin="0,5,0,0" Minimum="0" Maximum="100"
                                                     Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"
                                                     Foreground="{Binding KindBrushKey, Converter={StaticResource ResBrush}}"
                                                     Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding PercentText}" Style="{StaticResource Hint}" MinWidth="40"
                                               TextAlignment="Right" VerticalAlignment="Center" Margin="12,0"
                                               Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVis}}"/>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Tentar de novo" Padding="10,4" FontSize="12" Margin="0,0,6,0"
                                                ToolTip="Volta este item pra fila e começa de novo (um erro do YouTube como HTTP 403 costuma passar na segunda)"
                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="{Binding ActionLabel}" ToolTip="{Binding ActionTooltip}"
                                                Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12"
                                                Command="{Binding DataContext.JobActionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
