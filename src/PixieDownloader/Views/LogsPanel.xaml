<UserControl x:Class="PixieDownloader.Views.LogsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PixieDownloader.ViewModels"
             xmlns:core="clr-namespace:YtDlpCore;assembly=YtDlpCore"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">
    <Border Style="{StaticResource Card}" Padding="14">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBlock Text="Logs da sessão" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Nível mínimo" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox MinWidth="120" ItemsSource="{Binding LogLevelOptions}" SelectedItem="{Binding MinLogLevel, Mode=TwoWay}"/>
                    <Button Content="Abrir pasta de logs" Style="{StaticResource GhostButton}" Padding="10,5" Margin="10,0,0,0"
                            Command="{Binding OpenLogsFolderCommand}"/>
                </StackPanel>
            </DockPanel>

            <ListBox x:Name="LogList" ItemsSource="{Binding LogsView}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="{StaticResource Brush.Bg.Base}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:LogEntry}">
                        <Grid Margin="4,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                       Style="{StaticResource Hint}" FontFamily="{StaticResource Font.Mono}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Level}" Width="64"
                                       FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Source}" Style="{StaticResource Hint}" Width="64" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="12"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
