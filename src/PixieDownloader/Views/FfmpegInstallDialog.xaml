<Window x:Class="PixieDownloader.Views.FfmpegInstallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalar ffmpeg" Height="380" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="False" Background="{StaticResource Brush.Bg.Base}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Family}" FontSize="{StaticResource Font.Body}">
    <Border BorderBrush="{StaticResource Brush.Border.Default}" BorderThickness="1">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Instalar ffmpeg" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Escolha qual build baixar. O ffmpeg é necessário para converter o áudio em MP3."
                           Style="{StaticResource Hint}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <RadioButton x:Name="FullOption" GroupName="kind" IsChecked="True" Margin="0,0,0,12">
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Completo (recomendado) — ~80 MB" FontWeight="SemiBold"/>
                            <TextBlock Text="Build gyan.dev release-essentials. Suporta toda a gama de codecs e formatos de entrada."
                                       Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </RadioButton>

                <RadioButton x:Name="MinimalOption" GroupName="kind">
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Mínimo — ~25 MB" FontWeight="SemiBold"/>
                            <TextBlock Text="Build LGPL menor (BtbN). Funciona para conversão MP3 básica, mas pode não suportar todos os formatos exóticos."
                                       Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancelar" Style="{StaticResource GhostButton}" MinWidth="90" Click="OnCancel"/>
                <Button Content="Baixar" MinWidth="110" Margin="10,0,0,0" Click="OnOk" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
