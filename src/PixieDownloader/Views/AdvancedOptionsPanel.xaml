<UserControl x:Class="PixieDownloader.Views.AdvancedOptionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PixieDownloader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignWidth="700">
    <StackPanel>
        <!-- ── Saída: pasta, subpasta + nome (ou modelo à mão), prévia ── -->
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Saída" Style="{StaticResource SectionTitle}"/>

                <!-- Pasta: digitar/colar + Enter, ou Procurar -->
                <TextBlock Text="Pasta" Style="{StaticResource Label}" Margin="0,2,0,0"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" VerticalContentAlignment="Center"
                             Text="{Binding OutputDirectoryText, UpdateSourceTrigger=LostFocus}"
                             KeyDown="OnOutputDirectoryKeyDown"
                             ToolTip="Cole um caminho e tecle Enter. Se a pasta não existir, o primeiro download cria."/>
                    <Button Grid.Column="1" Content="Procurar" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding BrowseOutputDirectoryCommand}"/>
                    <Button Grid.Column="2" Content="Abrir" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Command="{Binding OpenOutputFolderCommand}"/>
                </Grid>

                <!-- Subpasta + Nome, ou o modelo à mão. "Personalizar" troca um pelo outro e fica no mesmo lugar nos dois. -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Text="Subpasta" Style="{StaticResource Label}" VerticalAlignment="Bottom"
                               Visibility="{Binding Settings.Paths.UseCustomTemplate, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBlock Grid.Column="2" Text="Nome" Style="{StaticResource Label}" VerticalAlignment="Bottom"
                               Visibility="{Binding Settings.Paths.UseCustomTemplate, Converter={StaticResource InverseBoolToVis}}"/>
                    <TextBlock Grid.Column="0" Text="Modelo" Style="{StaticResource Label}" VerticalAlignment="Bottom"
                               Visibility="{Binding Settings.Paths.UseCustomTemplate, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0"
                                    Visibility="{Binding Settings.Paths.UseCustomTemplate, Converter={StaticResource BoolToVis}}">
                            <Button Content="Desfazer" Style="{StaticResource GhostButton}" Padding="9,3" FontSize="12" Focusable="False"
                                    Command="{Binding UndoTemplateCommand}" ToolTip="Desfazer (Ctrl+Z)"/>
                            <Button Content="Refazer" Style="{StaticResource GhostButton}" Padding="9,3" FontSize="12" Focusable="False" Margin="6,0,0,0"
                                    Command="{Binding RedoTemplateCommand}" ToolTip="Refazer (Ctrl+Y)"/>
                            <Button Content="Resetar" Style="{StaticResource GhostButton}" Padding="9,3" FontSize="12" Focusable="False" Margin="6,0,0,0"
                                    Command="{Binding ResetTemplateCommand}" ToolTip="Volta ao que Subpasta e Nome montam. Dá pra desfazer."/>
                            <Button Content="{Binding MoreTokensButtonText}" Style="{StaticResource GhostButton}" Padding="9,3" FontSize="12"
                                    Focusable="False" Margin="14,0,0,0"
                                    Command="{Binding ToggleMoreTokensCommand}"
                                    ToolTip="Mais campos do yt-dlp (artista, ano, duração, resolução…)"/>
                        </StackPanel>
                        <CheckBox Content="Personalizar" VerticalAlignment="Center"
                                  IsChecked="{Binding Settings.Paths.UseCustomTemplate, Mode=TwoWay}"
                                  ToolTip="Escrever o modelo do yt-dlp à mão. Desmarcar volta pros seletores; o texto fica guardado."/>
                    </StackPanel>

                    <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding FolderOptions}"
                              SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                              Visibility="{Binding Settings.Paths.UseCustomTemplate, Converter={StaticResource InverseBoolToVis}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" ToolTip="{Binding ToolTip}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding NameOptions}"
                              SelectedItem="{Binding SelectedName, Mode=TwoWay}"
                              Visibility="{Binding Settings.Paths.UseCustomTemplate, Converter={StaticResource InverseBoolToVis}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" ToolTip="{Binding ToolTip}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                Visibility="{Binding Settings.Paths.UseCustomTemplate, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text=".ext" Style="{StaticResource Hint}" FontFamily="{StaticResource Font.Mono}"
                                       VerticalAlignment="Center" Margin="8,0,2,0"
                                       ToolTip="A extensão (.mp3, .mp4, .gif) entra sozinha no fim"/>
                            <!-- O desfazer da própria caixa fica desligado: o histórico é o do VM, que também vê os botões -->
                            <TextBox x:Name="CustomTemplateBox" VerticalContentAlignment="Center" FontFamily="{StaticResource Font.Mono}"
                                     IsUndoEnabled="False"
                                     Text="{Binding Settings.Paths.CustomTemplate, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoTemplateCommand}"/>
                                    <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoTemplateCommand}"/>
                                    <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoTemplateCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <!-- Não focáveis: o clique não tira o cursor da caixa, então o campo entra onde ele está -->
                        <ItemsControl ItemsSource="{Binding TokenPalette}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" ToolTip="{Binding ToolTip}" Style="{StaticResource GhostButton}"
                                            Padding="9,4" Margin="0,0,6,6" FontSize="12" Focusable="False"
                                            Click="OnInsertToken"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding MoreTokenPalette}"
                                      Visibility="{Binding ShowMoreTokens, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" ToolTip="{Binding ToolTip}" Style="{StaticResource GhostButton}"
                                            Padding="9,4" Margin="0,0,6,6" FontSize="12" Focusable="False"
                                            Click="OnInsertToken"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- Prévia: o caminho que um download vai ter (cinza = a pasta escolhida, roxo = o que o layout cria) -->
                <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="6"
                        Padding="8,6" Margin="0,12,0,0" ToolTip="{Binding PreviewPath}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding PreviewSegments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PathSegment}">
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock x:Name="sep" Text="›" Foreground="{StaticResource Brush.Text.Tertiary}"
                                                   Margin="4,0" VerticalAlignment="Center"/>
                                        <Border x:Name="chip" CornerRadius="4" Padding="5,2" Background="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="text" Text="{Binding Text}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                                           Foreground="{StaticResource Brush.Text.Secondary}"/>
                                                <TextBlock Text="{Binding Extension}" FontFamily="{StaticResource Font.Mono}" FontSize="12"
                                                           Foreground="{StaticResource Brush.Text.Tertiary}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                            <Setter TargetName="sep" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PathSegmentKind.Folder}">
                                            <Setter TargetName="chip" Property="Background" Value="{StaticResource Brush.Accent.Subtle}"/>
                                            <Setter TargetName="text" Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PathSegmentKind.File}">
                                            <Setter TargetName="text" Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding PreviewNote}" TextWrapping="Wrap" Margin="5,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── Opções avançadas ── (the download actions live in MainWindow's sticky footer) -->
        <Expander IsExpanded="{Binding Settings.Ui.AdvancedPanelExpanded, Mode=TwoWay}" Header="Opções avançadas" Margin="0,0,0,4">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Bitrate MP3" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding BitrateOptions}" SelectedItem="{Binding Settings.Audio.Bitrate, Mode=TwoWay}"/>

                    <CheckBox Content="Embutir capa (thumbnail)" Margin="0,12,0,0"
                              IsChecked="{Binding Settings.Audio.EmbedThumbnail, Mode=TwoWay}"/>
                    <CheckBox Content="Embutir metadados (ID3)" Margin="0,8,0,0"
                              IsChecked="{Binding Settings.Audio.EmbedMetadata, Mode=TwoWay}"/>

                    <TextBlock Text="Pular vídeos mais longos que (hh:mm)" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                    <TextBox Text="{Binding MaxDurationText, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center"
                             ToolTip="Deixe vazio para sem limite. Ex.: 00:10"/>

                    <TextBlock Text="Arquivo de cookies" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center"
                                 Text="{Binding Settings.Advanced.CookiesFilePath}"/>
                        <Button Grid.Column="1" Content="Escolher" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding BrowseCookiesFileCommand}"/>
                        <Button Grid.Column="2" Content="Limpar" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                Command="{Binding ClearCookiesCommand}"/>
                    </Grid>
                </StackPanel>

                <!-- Right column -->
                <StackPanel Grid.Column="2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.Advanced.Retries}" Style="{StaticResource Hint}"/>
                        <TextBlock Text="Retries" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <Slider Minimum="1" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Settings.Advanced.Retries, Mode=TwoWay}"/>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.Advanced.TimeoutSeconds, StringFormat={}{0}s}" Style="{StaticResource Hint}"/>
                        <TextBlock Text="Timeout (socket)" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <Slider Minimum="10" Maximum="600" IsSnapToTickEnabled="True" TickFrequency="10"
                            Value="{Binding Settings.Advanced.TimeoutSeconds, Mode=TwoWay}"/>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.Advanced.ParallelDownloads}" Style="{StaticResource Hint}"/>
                        <TextBlock Text="Downloads paralelos" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <Slider Minimum="1" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Settings.Advanced.ParallelDownloads, Mode=TwoWay}"/>
                    <TextBlock Text="⚠ Acima de 5 pode disparar rate-limit" Foreground="{StaticResource Brush.Warning}"
                               FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding ParallelWarning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Expander>
    </StackPanel>
</UserControl>
