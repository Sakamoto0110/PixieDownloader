<UserControl x:Class="PixieDownloader.Views.AdvancedOptionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PixieDownloader.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MainViewModel}"
             d:DesignWidth="700">
    <StackPanel>
        <!-- ── Template de saída ── -->
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Pasta e template de saída" Style="{StaticResource SectionTitle}"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center"
                             Text="{Binding Settings.Paths.LastOutputDirectory}" ToolTip="Pasta de saída"/>
                    <Button Grid.Column="1" Content="Procurar" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding BrowseOutputDirectoryCommand}"/>
                    <Button Grid.Column="2" Content="Abrir" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Command="{Binding OpenOutputFolderCommand}"/>
                </Grid>

                <TextBox Text="{Binding Settings.Paths.LastTemplate, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" FontFamily="{StaticResource Font.Mono}"/>

                <ItemsControl ItemsSource="{Binding TemplatePresets}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Style="{StaticResource GhostButton}" Padding="9,4" Margin="0,0,6,6"
                                    FontSize="12"
                                    Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Prévia: " Style="{StaticResource Hint}"/>
                    <TextBlock Text="{Binding TemplatePreview}" Style="{StaticResource Hint}"
                               FontFamily="{StaticResource Font.Mono}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Opções avançadas ── -->
        <Expander IsExpanded="{Binding Settings.Ui.AdvancedPanelExpanded, Mode=TwoWay}" Header="Opções avançadas" Margin="0,0,0,10">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Bitrate MP3" Style="{StaticResource Label}"/>
                    <ComboBox ItemsSource="{Binding BitrateOptions}" SelectedItem="{Binding Settings.Audio.Bitrate, Mode=TwoWay}"/>

                    <CheckBox Content="Embutir capa (thumbnail)" Margin="0,12,0,0"
                              IsChecked="{Binding Settings.Audio.EmbedThumbnail, Mode=TwoWay}"/>
                    <CheckBox Content="Embutir metadados (ID3)" Margin="0,8,0,0"
                              IsChecked="{Binding Settings.Audio.EmbedMetadata, Mode=TwoWay}"/>

                    <TextBlock Text="Pular vídeos mais longos que (hh:mm)" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                    <TextBox Text="{Binding MaxDurationText, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center"
                             ToolTip="Deixe vazio para sem limite. Ex.: 00:10"/>

                    <TextBlock Text="Arquivo de cookies" Style="{StaticResource Label}" Margin="0,14,0,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center"
                                 Text="{Binding Settings.Advanced.CookiesFilePath}"/>
                        <Button Grid.Column="1" Content="Escolher" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding BrowseCookiesFileCommand}"/>
                        <Button Grid.Column="2" Content="Limpar" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                                Command="{Binding ClearCookiesCommand}"/>
                    </Grid>
                </StackPanel>

                <!-- Right column -->
                <StackPanel Grid.Column="2">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.Advanced.Retries}" Style="{StaticResource Hint}"/>
                        <TextBlock Text="Retries" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <Slider Minimum="1" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Settings.Advanced.Retries, Mode=TwoWay}"/>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.Advanced.TimeoutSeconds, StringFormat={}{0}s}" Style="{StaticResource Hint}"/>
                        <TextBlock Text="Timeout (socket)" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <Slider Minimum="10" Maximum="600" IsSnapToTickEnabled="True" TickFrequency="10"
                            Value="{Binding Settings.Advanced.TimeoutSeconds, Mode=TwoWay}"/>

                    <DockPanel Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Settings.Advanced.ParallelDownloads}" Style="{StaticResource Hint}"/>
                        <TextBlock Text="Downloads paralelos" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <Slider Minimum="1" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1"
                            Value="{Binding Settings.Advanced.ParallelDownloads, Mode=TwoWay}"/>
                    <TextBlock Text="⚠ Acima de 5 pode disparar rate-limit" Foreground="{StaticResource Brush.Warning}"
                               FontSize="12" Margin="0,4,0,0"
                               Visibility="{Binding ParallelWarning, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- ── Download actions ── -->
        <Border Style="{StaticResource Card}" Padding="14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource GhostButton}" MinWidth="100" Margin="8,0,0,0"
                        Command="{Binding CancelCommand}"
                        Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>

                <Button DockPanel.Dock="Right" Content="Baixar selecionados" MinWidth="180" Padding="16,9"
                        Command="{Binding DownloadCommand}"
                        Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVis}}"/>
                <Button DockPanel.Dock="Right" Content="Baixar como MP3" MinWidth="180" Padding="16,9"
                        Command="{Binding DownloadCommand}"
                        Visibility="{Binding IsPlaylist, Converter={StaticResource InverseBoolToVis}}"/>

                <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}"
                           Text="{Binding SelectedCountText}"
                           Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVis}}"/>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
