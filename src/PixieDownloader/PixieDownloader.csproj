<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Sdk goes into the single-file bundle with the app: plugins resolve it from here by name (they never -->
  <!-- carry a copy), so exe and plugin API can't drift apart. Plugin authors get the same assembly as a .nupkg. -->
  <ItemGroup>
    <ProjectReference Include="..\YtDlpCore\YtDlpCore.csproj" />
    <ProjectReference Include="..\PixieDownloader.Sdk\PixieDownloader.Sdk.csproj" />
  </ItemGroup>

  <!-- Logo assets: the .ico brands the header badge (loaded via pack URI) and the .exe/window icon. -->
  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\*.ico" />
  </ItemGroup>

  <!-- The plugin host tests drive PluginCatalog/PluginLoadContext directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PluginHost.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <!-- The one place the app version lives. It becomes the exe's file/product version, the "v1.4.0" in -->
    <!-- the header (AppInfo.cs) and the yt-dlp service's User-Agent. Bump it when cutting a release; -->
    <!-- the GitHub release titles ("PixieDownloader 1.3") are the history so far — tags are Stable/Portable/Net10. -->
    <Version>1.8.0</Version>
  </PropertyGroup>

  <!-- dotnet publish -c Release -> a single PixieDownloader.exe. Two flavours, picked by profile: -->
  <!--   -p:PublishProfile=FrameworkDependent ~1 MB, needs the .NET 10 Desktop Runtime installed -->
  <!--   -p:PublishProfile=SelfContained      ~62 MB, runtime bundled in, runs on a bare Windows -->
  <!-- Plain `dotnet publish` with no profile behaves like FrameworkDependent. -->
  <!-- Guarded by _IsPublishing so plain builds (and the VS/design-time build) don't get an RID-specific -->
  <!-- output path, which breaks the XAML designer. SelfContained is only defaulted when the profile -->
  <!-- hasn't set it, so the profile wins no matter which one MSBuild evaluates first. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Symbols inside the exe and no .pdb tagging along from YtDlpCore, so publish/ -->
    <!-- holds nothing but PixieDownloader.exe. -->
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

</Project>
