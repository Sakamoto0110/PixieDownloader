<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dev-only smoke-test harness for the video/slowmo pipeline. NOT part of PixieDownloader.slnx and
    NOT referenced by the WPF app, so it never touches the app's 2-DLL output.
    Run it with scripts/smoke.ps1 (or "dotnet run" pointing at this csproj).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SmokeTest</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\YtDlpCore\YtDlpCore.csproj" />
  </ItemGroup>

</Project>
