<UserControl x:Class="Pixie.TrackTracer.TracklistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pixie.TrackTracer">
    <!-- Host styles by DynamicResource (the view is built before it is in the tree); the one converter it
         needs is WPF's own, kept here so the view stands on its own. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Style="{DynamicResource Card}" Padding="14">
        <DockPanel>
            <!-- Header: title + the one decision the user makes per video -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding WriteToFile, Mode=TwoWay}"
                          IsEnabled="{Binding HasList}" Content="Gravar no MP3 ao baixar"
                          ToolTip="Capítulos ID3 (CHAP/CTOC), que VLC, foobar2000 e mpv mostram, mais a lista completa em TXXX:PIXIE_TRACKLIST. Só para MP3 por enquanto."/>
                <TextBlock Text="Tracklist" Style="{DynamicResource SectionTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Empty state / playlist notice -->
            <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" Style="{DynamicResource Hint}" TextWrapping="Wrap"
                       Visibility="{Binding ShowMessage, Converter={StaticResource BoolToVis}}"/>

            <!-- One shared-size scope for the summary line and every row: the "number · time · title" block is as
                 wide as the widest of them, and the links start right after it, left-aligned — one column. -->
            <DockPanel Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}}" Grid.IsSharedSizeScope="True">
                <!-- The video -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>
                    <TextBlock Text="{Binding Url}" Style="{DynamicResource Hint}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Sources: the block carries the provenance, and the count is the decisive signal -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Sources}" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SourceOption}">
                            <ToggleButton Content="{Binding Label}" ToolTip="{Binding ToolTip}" Style="{DynamicResource GhostToggleButton}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" Padding="10,5" FontSize="12" Margin="0,0,6,6"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Summary}" Style="{DynamicResource Hint}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <!-- Expansion: every link at once, one analysis at a time, and how deep it may go -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Content="{Binding ExpandAllLabel}" Style="{DynamicResource GhostButton}" Padding="8,3" FontSize="12"
                                Command="{Binding ExpandAllCommand}" Visibility="{Binding HasExpandable, Converter={StaticResource BoolToVis}}"
                                ToolTip="Analisa cada link da lista (um por vez, 2–4 s cada) e aninha o que achar, até o limite de profundidade"/>
                        <Button Content="Parar" Style="{DynamicResource GhostButton}" Padding="8,3" FontSize="12" Margin="6,0,0,0"
                                Command="{Binding StopExpandCommand}" Visibility="{Binding IsExpandingAll, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="profundidade" Style="{DynamicResource Hint}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <ComboBox ItemsSource="{Binding DepthOptions}" SelectedItem="{Binding MaxDepth, Mode=TwoWay}" MinWidth="56" FontSize="12"
                                  ToolTip="Até onde a árvore pode ir: 1 = só a lista deste vídeo; 2 = os links dela; 3 = os links dos links… Fica salvo."/>
                    </StackPanel>
                </Grid>

                <!-- Detection notes (hints the detector saw: "tracklist in the comments", an external link…) -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Notes}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{DynamicResource Hint}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The raw report, for tuning the heuristic against a video that came out wrong -->
                <Expander DockPanel.Dock="Bottom" Header="Detalhes da detecção" Margin="0,8,0,0" IsExpanded="False">
                    <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalContentAlignment="Top" FontFamily="{DynamicResource Font.Mono}" FontSize="11"
                             MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Expander>

                <!-- The tracks: a tree. The row template is implicit for NodeRow, so the inner ItemsControl of each
                     row renders the children with the same template — nesting without a TreeView (the theme has no
                     style for one). Depth shows as indentation; a linked row expands on its button. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <DataTemplate DataType="{x:Type local:NodeRow}">
                            <StackPanel>
                                <Grid Margin="{Binding Indent}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Track"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- ▾/▸ folds an expanded row; nothing for a leaf -->
                                        <Button Grid.Column="0" Content="{Binding CollapseGlyph}" Style="{DynamicResource IconButton}" Padding="0" Width="16" Height="16"
                                                FontSize="11" HorizontalAlignment="Left" Command="{Binding ToggleCollapseCommand}"
                                                Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}" ToolTip="Recolher / mostrar as faixas de dentro"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Number}" Style="{DynamicResource Hint}" FontFamily="{DynamicResource Font.Mono}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Time}" FontFamily="{DynamicResource Font.Mono}"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Text}" MaxWidth="520" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,2,0,2" VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" MaxWidth="360" VerticalAlignment="Center"
                                                   Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}">
                                            <Hyperlink NavigateUri="{Binding Link}" RequestNavigate="OnLinkRequested" ToolTip="{Binding Link}"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}">
                                                <Run Text="{Binding Link, Mode=OneWay}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                        <!-- The link's expansion: the button, then what it found (or why it did not) -->
                                        <Button Content="Expandir" Style="{DynamicResource GhostButton}" Padding="8,2" FontSize="11" Margin="10,0,0,0"
                                                Command="{Binding ExpandCommand}" Visibility="{Binding ShowExpand, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Analisa esse link como um vídeo e aninha a tracklist dele aqui (2–4 s)"/>
                                        <Button Content="Tentar de novo" Style="{DynamicResource GhostButton}" Padding="8,2" FontSize="11" Margin="10,0,0,0"
                                                Command="{Binding ExpandCommand}" Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding StateText}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="420"
                                                   ToolTip="{Binding StateText}" Visibility="{Binding ShowState, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Error}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <!-- The tracks found inside this one, same template, one level in -->
                                <ItemsControl ItemsSource="{Binding Children}" Visibility="{Binding ShowChildren, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ScrollViewer.Resources>
                    <ItemsControl ItemsSource="{Binding Entries}"/>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>
