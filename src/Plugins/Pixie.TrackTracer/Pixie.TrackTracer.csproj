<Project Sdk="Microsoft.NET.Sdk">

  <!-- Module 1 of docs/ROADMAP.md — TrackTracer, "traces the tracks" of a mix: the tracklist detector -->
  <!-- (description → pinned comment → other top comments → yt-dlp chapters as fallback), a "Tracklist" tab -->
  <!-- showing what was found per source, and the ID3 chapters (CHAP/CTOC + the full tree in -->
  <!-- TXXX:PIXIE_TRACKLIST) written into the MP3 after the download. Installed as plugins/tracktracer/ next -->
  <!-- to the exe; the release ships it as its own zip. (Was Pixie.Tracklist / plugins/tracklist/ in 1.6.) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Pixie.TrackTracer</RootNamespace>
    <!-- No plugin.json: the host reads id (folder), name, version, apiVersion and the entry class from the -->
    <!-- assembly's metadata. So this is the plugin's version, AssemblyTitle is what the Plugins tab shows, and -->
    <!-- Description is what the store ("Plugins oficiais") shows — release.ps1 copies it into plugins.json. -->
    <Version>1.0.0</Version>
    <AssemblyTitle>TrackTracer</AssemblyTitle>
    <Description>Acha a tracklist de um mix na descrição ou nos comentários do vídeo, mostra as fontes numa aba e grava as faixas como capítulos no MP3 baixado.</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared with the host, never copied here (PluginLoadContext resolves both from the default context). -->
    <ProjectReference Include="..\..\PixieDownloader.Sdk\PixieDownloader.Sdk.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\YtDlpCore\YtDlpCore.csproj" Private="false" ExcludeAssets="runtime" />
    <!-- The plugin's own dependency: it lands next to the plugin and is resolved from there. ID3v2 CHAP/CTOC -->
    <!-- frames are what podcast players and foobar2000/VLC/mpv read as chapters. -->
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <None Include="THIRD-PARTY.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The tests drive TracklistLine (internal) directly, as they did when it lived in the core. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Pixie.TrackTracer.Tests" />
  </ItemGroup>

  <!-- Dev convenience: mirror the build into the app's output as plugins/tracktracer/, so `dotnet run` has it. -->
  <Target Name="CopyToAppPlugins" AfterTargets="Build">
    <ItemGroup>
      <_TrackTracerOutput Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TrackTracerOutput)"
          DestinationFolder="$(MSBuildThisFileDirectory)..\..\PixieDownloader\bin\$(Configuration)\net10.0-windows\plugins\tracktracer\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
