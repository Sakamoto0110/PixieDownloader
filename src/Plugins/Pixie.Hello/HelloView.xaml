<UserControl x:Class="Pixie.Hello.HelloView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Host styles by DynamicResource, never StaticResource: the view is built before it is in the tree,
         and a plugin must not blow up because the host renamed a style. -->
    <Border Style="{DynamicResource Card}" Padding="14" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="420">
        <StackPanel>
            <TextBlock Text="Hello, plugin" Style="{DynamicResource SectionTitle}"/>
            <TextBlock x:Name="Info" Style="{DynamicResource Label}"/>

            <WrapPanel Margin="0,12,0,0">
                <Button Content="Checar yt-dlp" Style="{DynamicResource GhostButton}" Margin="0,0,6,6" Click="OnCheckYtDlpClick"/>
                <Button Content="Cumprimentar" Style="{DynamicResource GhostButton}" Margin="0,0,6,6" Click="OnGreetClick"/>
            </WrapPanel>

            <TextBlock x:Name="Result" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</UserControl>
