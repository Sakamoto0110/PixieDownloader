# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.user
*.suo

# Visual Studio / Rider
.vs/
.idea/
*.userprefs

# Publish profiles generated by the VS publish dialog. The curated ones
# (FrameworkDependent/SelfContained) are versioned; these show up beside them in
# the dialog pointing at stale output folders, so keep them out of the repo.
FolderProfile*.pubxml

# Runtime artifacts created next to the executable.
# Anchored to the repo root (leading slash) so they don't also match the source
# folders src/YtDlpCore/Tools and src/YtDlpCore/Cache — git ignore is case-insensitive
# on Windows, and an unanchored "tools/"/"cache/" was swallowing that source code.
/tools/
/cache/
/logs/
settings.json
settings.json.bak

# NuGet
*.nupkg
packages/

# Smoke test: local-only URL for the online (B) test
test.txt

# Claude Code: local-only permission allowlist (not for a public repo)
.claude/settings.local.json
